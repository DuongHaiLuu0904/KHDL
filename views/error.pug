//- Error Page Template
//- Displayed when an error occurs

extends layout

block content
    .container
        .error-page
            h2.error-title ⚠️ Oops! Something went wrong
            p.error-message= message

            //- Special handling for rate limit errors
            if message && message.includes('Rate limit')
                .rate-limit-notice
                    p.notice-box
                        strong 🕐 API Rate Limit Reached
                    p The CoinGecko free API has strict rate limits. The data has been cached to minimize requests.
                    p 
                        strong What you can do:
                    ul
                        li Wait 30-60 seconds before trying again
                        li Previously viewed coins are cached and will load instantly
                        li Avoid refreshing the page multiple times rapidly

            if error && !message.includes('Rate limit')
                .error-details
                    p.text-small Error details:
                    pre.error-stack= error

            .actions
                a.btn.btn-primary(href="/") ← Back to Home
